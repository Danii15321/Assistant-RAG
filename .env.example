# Étape 0 : garder le compte Groq sur Free ; aucun moyen de paiement nécessaire.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Étape 1 : .env local généré par scripts/local/bootstrap.py, séparé de .env.local.
POSTGRES_PASSWORD=
FRONTEND_PORT=3000
BACKEND_PORT=8000
DATABASE_PORT=5433
# DATABASE_URL et API_INTERNAL_URL sont injectées côté serveur par compose.yaml.
# Better Auth avec identifiants est local ; Blob et Queues seront qualifiés au jalon Vercel.

# Generated by scripts/local/bootstrap.py; local secrets only.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
TEST_AUTH_SECRET=

# Étape 6 : clé locale extraite dans .secrets/groq_api_key par configure_llm.py.
# Ne confirmer true que sur un compte Groq Free ; faux par défaut.
LLM_FREE_PLAN_CONFIRMED=false
