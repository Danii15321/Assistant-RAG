FROM python:3.10-slim@sha256:6ff506466f8b1e981719b468cc0023b8ef000b983cdec0eafe119d01f379e31d
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache OMP_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false
COPY requirements.lock.txt requirements-embeddings.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt \
    && pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-embeddings.lock.txt \
    && pip check \
    && python -c 'import tiktoken; tiktoken.get_encoding("o200k_harmony")'
COPY app ./app
COPY scripts/prepare_cloud_model.py ./scripts/prepare_cloud_model.py
RUN PYTHONPATH=/app python scripts/prepare_cloud_model.py
ENV HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 EMBEDDING_PATH=/opt/models/e5
# Vercel routes to port 80; app-level authorization protects all private operations.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "80", "--workers", "1", "--no-access-log"]
